{
  "name": "cpmoshai",
  "version": "0.1.0",
  "description": "MCP server for cPanel and WHM",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/cli.ts stdio",
    "serve": "bun run src/cli.ts serve",
    "cli": "bun run src/cli.ts",
    "build": "bun build --compile --minify --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-linux-x64 src/cli.ts --outfile dist/cpmoshai",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
